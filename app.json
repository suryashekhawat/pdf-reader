      },
      "predictiveBackGestureEnabled": false,
      "package": "com.singshekhawat.PDFReader"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "18a1e8dd-09f1-4884-ae32-3c29a6b3d173"
